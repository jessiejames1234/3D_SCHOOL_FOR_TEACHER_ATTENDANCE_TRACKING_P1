# Copy to .env and set values for this computer or hosting server.
# Server environment variables take priority. Restart PHP after changing .env.
DB_HOST="localhost"
DB_USER="root"
DB_PASS=""
DB_NAME="your_database"
MAIL_DRIVER="smtp"
# Set MAIL_DRIVER="apps_script" to use your deployed GmailApp web app.
# The secret must match SECRET_KEY in your script. SMTP settings are then ignored.
MAIL_APPS_SCRIPT_URL=""
MAIL_APPS_SCRIPT_SECRET=""
MAIL_APPS_SCRIPT_TIMEOUT="30"
MAIL_SMTP_AUTH="auto"
MAIL_SMTP_TIMEOUT="15"
MAIL_SMTP_HOST="smtp.gmail.com"
MAIL_SMTP_PORT="587"
MAIL_SMTP_SECURE="tls"
MAIL_SMTP_USER="youraccount@gmail.com"
MAIL_SMTP_PASS="your_app_password"
MAIL_FROM_EMAIL="youraccount@gmail.com"
MAIL_FROM_NAME="Teacher Attendance"
APP_RESET_SECRET="replace_with_a_long_random_secret"
APP_FORCE_HTTPS="1"
VAPID_SUBJECT="mailto:youraccount@gmail.com"
VAPID_PUBLIC_KEY="your_existing_public_key"
VAPID_PRIVATE_KEY="your_existing_private_key"
