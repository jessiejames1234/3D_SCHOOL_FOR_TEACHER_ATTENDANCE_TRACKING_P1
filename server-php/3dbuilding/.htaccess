<IfModule mod_mime.c>
    AddType model/gltf-binary .glb
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?i:glb)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType model/gltf-binary "access plus 1 year"
</IfModule>
