 tbl_flag_types ft_in    ON ar.flag_in_id = ft_in.flag_id       LEFT JOIN tbl_flag_types ft_check ON ar.flag_check_id = ft_check.flag_id       LEFT JOIN tbl_flag_types ft_out   ON ar.flag_out_id = ft_out.flag_id      WHERE ar.date = ? ORDER BY ar.date DESC, cs.start_time, u.last_name, u.first_name
